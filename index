<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Quantum Survey Voxel GIS - Royal Engineer Tactical Console (Prism Core)</title>
    <style>
        :root {
            --bg-canvas: #0b0f14;
            --accent-red: #ff3366;
            --accent-green: #00ffcc;
            --accent-amber: #ffaa00;
            --panel-bg: rgba(5, 10, 15, 0.92);
            --text-hud: #00ffcc;
        }
        * { box-sizing: border-box; }
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: var(--bg-canvas); color: var(--text-hud); font-family: 'Courier New', monospace; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
        
        #view-container { position: relative; width: 100%; height: 100%; }
        
        /* Interactive Map / Satellite Viewport */
        #map-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background: #000; overflow: hidden; }
        #apple-map-frame { width: 100%; height: 100%; border: none; filter: contrast(1.15) saturate(1.2); }
        
        /* Royal Topographic Grid Overlay Mask */
        #topographic-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; background: radial-gradient(circle, transparent 40%, rgba(0,255,204,0.08) 100%); box-shadow: inset 0 0 50px rgba(0,0,0,0.8); }

        /* 3D Quantum Voxel Canvas */
        #webgl-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; opacity: 0; transition: opacity 0.6s ease; }
        .active-3d #webgl-canvas { opacity: 1; pointer-events: auto; }
        .active-3d #map-container { opacity: 0; pointer-events: none; }

        /* --- TACTICAL SIDE-WINGS LAYOUT --- */
        .wing-panel { position: absolute; top: 16px; z-index: 10; width: 280px; background: var(--panel-bg); border: 1px solid var(--accent-green); border-radius: 6px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); padding: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.8); display: flex; flex-direction: column; gap: 8px; }
        
        #left-wing { left: 16px; }
        #right-wing { right: 16px; width: 290px; }

        .wing-header { font-size: 0.75rem; color: var(--accent-red); font-weight: bold; border-bottom: 1px dashed rgba(0,255,204,0.3); padding-bottom: 4px; letter-spacing: 1px; display: flex; justify-content: space-between; align-items: center; }
        .data-row { display: flex; justify-content: space-between; font-size: 0.75rem; color: #aaa; }
        .data-val { color: var(--accent-green); font-weight: bold; }
        
        /* Red-Flag Deficit Protocol Styling */
        .status-red { color: var(--accent-red) !important; animation: pulse-red 1.5s infinite; }
        @keyframes pulse-red { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }

        /* Tactical PIP Camera Stream View */
        #cam-container { width: 100%; height: 90px; background: #000; border: 1px solid var(--accent-green); border-radius: 4px; overflow: hidden; position: relative; margin-top: 4px; }
        #tactical-video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
        .cam-overlay { position: absolute; bottom: 4px; left: 6px; font-size: 0.6rem; color: var(--accent-amber); background: rgba(0,0,0,0.7); padding: 2px 4px; border-radius: 2px; }

        /* --- ENGINEER DEBUG TERMINAL MODAL --- */
        #debug-terminal { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80vw; max-width: 600px; height: 350px; background: rgba(2, 6, 10, 0.96); border: 2px solid var(--accent-green); border-radius: 8px; z-index: 100; display: none; flex-direction: column; box-shadow: 0 0 40px rgba(0,255,204,0.3); backdrop-filter: blur(15px); }
        .debug-header { background: #00ffcc; color: #000; padding: 6px 12px; font-weight: bold; font-size: 0.75rem; display: flex; justify-content: space-between; align-items: center; }
        .debug-body { flex: 1; padding: 10px; overflow-y: auto; font-size: 0.7rem; color: #00ffcc; display: flex; flex-direction: column; gap: 4px; }
        .debug-log-line { border-bottom: 1px dashed rgba(0,255,204,0.2); padding-bottom: 2px; }

        /* --- BOTTOM LIVE TELEMETRY PACKET STREAM TABLE --- */
        #telemetry-stream-panel { position: absolute; bottom: 85px; left: 16px; right: 16px; z-index: 10; background: var(--panel-bg); border: 1px solid var(--accent-green); border-radius: 6px; padding: 8px 12px; backdrop-filter: blur(10px); display: flex; flex-direction: column; gap: 4px; max-height: 105px; overflow-y: auto; }
        .stream-title { font-size: 0.7rem; color: var(--accent-amber); font-weight: bold; letter-spacing: 1px; display: flex; justify-content: space-between; }
        table.stream-table { width: 100%; border-collapse: collapse; font-size: 0.7rem; text-align: left; }
        table.stream-table th { color: #00ffcc; border-bottom: 1px solid #114433; padding: 2px 4px; }
        table.stream-table td { padding: 2px 4px; border-bottom: 1px dashed rgba(0,255,204,0.15); color: #ddd; }

        /* --- BOTTOM HANDHELD CONSOLE DECK --- */
        #console-deck { position: absolute; bottom: 16px; left: 16px; right: 16px; z-index: 10; background: var(--panel-bg); padding: 10px 16px; border: 1px solid var(--accent-green); border-radius: 8px; backdrop-filter: blur(10px); display: flex; gap: 8px; align-items: center; justify-content: space-between; box-shadow: 0 4px 25px rgba(0,0,0,0.9); flex-wrap: wrap; }
        
        .deck-group { display: flex; gap: 6px; align-items: center; flex: 1; min-width: 120px; }
        input { background: #111; border: 1px solid var(--accent-green); color: #fff; padding: 6px 8px; font-family: monospace; width: 100%; border-radius: 4px; font-size: 0.75rem; outline: none; }
        
        button { background: var(--accent-green); color: #050505; border: none; padding: 8px 12px; font-weight: bold; cursor: pointer; border-radius: 4px; font-family: monospace; font-size: 0.75rem; transition: 0.2s; white-space: nowrap; flex: 1; box-shadow: 0 2px 6px rgba(0,255,204,0.3); }
        button:active { transform: scale(0.96); background: var(--accent-red); color: #fff; }
        .btn-alt { background: #112222; color: var(--accent-green); border: 1px solid var(--accent-green); }

        /* Karma Archive Side Panel (*.krm Soul Files) */
        #karma-archive-panel { position: absolute; top: 16px; right: 320px; z-index: 10; width: 210px; background: var(--panel-bg); border: 1px solid var(--accent-green); border-radius: 6px; padding: 10px; display: flex; flex-direction: column; gap: 6px; max-height: 240px; overflow-y: auto; }
        .karma-item { font-size: 0.65rem; background: #0c1a1a; border: 1px solid #114433; padding: 4px 6px; border-radius: 3px; cursor: pointer; color: #00ffcc; display: flex; justify-content: space-between; align-items: center; }
        .karma-item:hover { background: #113333; border-color: var(--accent-amber); }

        @media (max-width: 1024px) {
            .wing-panel { width: 230px; padding: 8px; }
            #right-wing { right: 16px; width: 240px; }
            #karma-archive-panel { display: none; }
        }
    </style>
</head>
<body>
    <div id="view-container">
        <!-- Interactive Map Viewport (Apple Maps / Satellite Raster Feed) -->
        <div id="map-container">
            <iframe id="apple-map-frame" src="https://maps.apple.com/?q=18.7883,98.9853&z=18&t=h" allowfullscreen></iframe>
        </div>
        <!-- Royal Topographic Grid Overlay Mask -->
        <div id="topographic-mask"></div>
        <!-- 3D Quantum Voxel Canvas -->
        <canvas id="webgl-canvas"></canvas>
        
        <!-- --- ENGINEER DEBUG TERMINAL --- -->
        <div id="debug-terminal">
            <div class="debug-header">
                <span>[ 🛡️ ROYAL ENGINEER DEBUG TERMINAL (RAW LOGS) ]</span>
                <button id="close-debug" style="background:#000; color:#00ffcc; padding:2px 6px; font-size:0.65rem; flex:none;">[X] CLOSE</button>
            </div>
            <div id="debug-body" class="debug-body">
                <div class="debug-log-line">[SYSTEM] Prism Core Initialized. Zero-Persistence Mode Active.</div>
                <div class="debug-log-line">[GPS] Awaiting Hardware Fix...</div>
                <div class="debug-log-line">[IMU] DeviceOrientation Listener Standby...</div>
            </div>
        </div>

        <!-- --- LEFT WING: Spatial Telemetry & Real GPS --- -->
        <div class="wing-panel" id="left-wing">
            <div class="wing-header">
                <span>[ SPATIAL TELEMETRY ]</span>
                <span id="gps-status-badge" class="status-red">● NO FIX</span>
            </div>
            <div class="data-row"><span>Lat/Lng:</span><span id="coords" class="data-val status-red">18.7883, 98.9853</span></div>
            <div class="data-row"><span>Azimuth (True North):</span><span id="azimuth-val" class="data-val status-red">--° (DISCONNECTED)</span></div>
            <div class="data-row"><span>Laser Rangefinder:</span><span id="laser-val" class="data-val">0.0 m</span></div>
            <div class="data-row"><span>Elevation (Z MSL):</span><span id="elev-val" class="data-val status-red">UNKNOWN</span></div>
            <button id="gps-btn" class="btn-alt" style="margin-top: 4px; padding: 5px;">🛰️ LOCK REAL GPS (IPHONE)</button>
        </div>

        <!-- --- KARMA ARCHIVE SIDE PANEL (*.krm Soul Files) --- -->
        <div id="karma-archive-panel">
            <div class="wing-header" style="font-size: 0.7rem;">
                <span>[ SOUL ARCHIVE *.krm ]</span>
            </div>
            <div id="karma-list" style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: 0.65rem; color: #555; text-align: center; padding: 6px;">(No Karma Recorded)</div>
            </div>
        </div>

        <!-- --- RIGHT WING: Hardware Guard & IMU Unlock & Tactical Cam --- -->
        <div class="wing-panel" id="right-wing">
            <div class="wing-header">
                <span>[ HARDWARE & IMU ]</span>
                <span id="fps" class="data-val">60 FPS</span>
            </div>
            <div class="data-row"><span>IMU Ring Buffer:</span><span id="imu-status" class="data-val status-red">LOCKED / NO PERM</span></div>
            <div class="data-row"><span>Alpha / Beta:</span><span id="imu-data" class="data-val status-red">-- , --</span></div>
            
            <!-- Tactical PIP Camera Stream -->
            <div id="cam-container">
                <video id="tactical-video" autoplay playsinline muted></video>
                <div id="cam-overlay-text" class="cam-overlay status-red">CAM: OFFLINE</div>
            </div>
            <div style="display: flex; gap: 4px; margin-top: 2px;">
                <button id="imu-btn" class="btn-alt" style="padding: 4px; font-size: 0.65rem; background: #113322;">🔓 UNLOCK IMU</button>
                <button id="cam-toggle" class="btn-alt" style="padding: 4px; font-size: 0.65rem;">📷 CAM</button>
            </div>
        </div>

        <!-- --- BOTTOM LIVE TELEMETRY PACKET STREAM TABLE --- -->
        <div id="telemetry-stream-panel">
            <div class="stream-title">
                <span>[ RAW TELEMETRY STREAM PACKETS ]</span>
                <span id="stream-status" class="status-red">LISTENING BUFFER...</span>
            </div>
            <table class="stream-table">
                <thead>
                    <tr>
                        <th>SOURCE</th>
                        <th>PACKET ID</th>
                        <th>STATUS / VALUE</th>
                        <th>TIMESTAMP</th>
                    </tr>
                </thead>
                <tbody id="stream-tbody">
                    <tr>
                        <td class="status-red">[EUC]</td>
                        <td>PKT_001</td>
                        <td class="status-red">OFFLINE (NO LINK)</td>
                        <td>--:--:--</td>
                    </tr>
                    <tr>
                        <td class="status-red">[iPhone]</td>
                        <td>IMU_RAW</td>
                        <td class="status-red">WAITING PERMISSION</td>
                        <td>--:--:--</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- --- BOTTOM HANDHELD CONSOLE DECK --- -->
        <div id="console-deck">
            <div class="deck-group">
                <input type="text" id="lat-input" value="18.7883" placeholder="Lat">
                <input type="text" id="lng-input" value="98.9853" placeholder="Lng">
            </div>
            <div class="deck-group" style="flex: 1.8; display: flex; gap: 5px;">
                <button id="debug-btn" class="btn-alt" style="background:#113322; color:#00ffcc;">🛠️ DEBUG</button>
                <button id="pin-btn" class="btn-alt">📍 PIN</button>
                <button id="record-karma-btn" style="background: var(--accent-amber); color: #000;">📂 *.krm</button>
                <button id="transfer-btn">⚡ 3D</button>
            </div>
        </div>
    </div>

    <!-- Raw WebGL & Three.js CDN -->
    <script type="module">
        import * as THREE from 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js';

        let lat = 18.7883, lng = 98.9853;
        let active3D = false;
        let gpsAcquired = false;
        let imuActive = false;
        const karmaArchives = [];

        function logDebug(message) {
            const body = document.getElementById('debug-body');
            const timeStr = new Date().toTimeString().split(' ')[0];
            const div = document.createElement('div');
            div.className = 'debug-log-line';
            div.innerText = `[${timeStr}] ${message}`;
            body.appendChild(div);
            body.scrollTop = body.scrollHeight;
        }

        // --- Debug Terminal Toggle ---
        document.getElementById('debug-btn').addEventListener('click', () => {
            const term = document.getElementById('debug-terminal');
            term.style.display = term.style.display === 'flex' ? 'none' : 'flex';
            logDebug("Debug Terminal toggled by Engineer.");
        });
        document.getElementById('close-debug').addEventListener('click', () => {
            document.getElementById('debug-terminal').style.display = 'none';
        });

        // --- 1. Real GPS Hardware Integration & Apple Maps Sync ---
        document.getElementById('gps-btn').addEventListener('click', () => {
            if (!navigator.geolocation) {
                logDebug("ERROR: Geolocation API not supported.");
                alert('Geolocation not supported');
                return;
            }
            logDebug("REQUEST: Acquiring iPhone GPS High Accuracy Position...");
            document.getElementById('coords').innerText = "ACQUIRING GPS...";
            navigator.geolocation.getCurrentPosition((position) => {
                gpsAcquired = true;
                lat = position.coords.latitude;
                lng = position.coords.longitude;
                const accuracy = position.coords.accuracy;
                
                logDebug(`SUCCESS: GPS Locked -> Lat: ${lat}, Lng: ${lng} (Accuracy: ±${accuracy}m)`);
                document.getElementById('coords').innerText = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                document.getElementById('coords').className = "data-val";
                document.getElementById('gps-status-badge').innerText = "● LOCKED (TRUE)";
                document.getElementById('gps-status-badge').className = "data-val";
                document.getElementById('lat-input').value = lat.toFixed(4);
                document.getElementById('lng-input').value = lng.toFixed(4);
                
                const mapFrame = document.getElementById('apple-map-frame');
                mapFrame.src = `https://maps.apple.com/?q=${lat},${lng}&z=18&t=h`;

                if (position.coords.heading) {
                    document.getElementById('azimuth-val').innerText = position.coords.heading.toFixed(0) + "° TRUE";
                    document.getElementById('azimuth-val').className = "data-val";
                }
            }, (err) => {
                logDebug(`ERROR: GPS Lock Failed -> ${err.message}`);
                alert('GPS Lock Failed or Denied.');
                document.getElementById('coords').innerText = "18.7883, 98.9853";
            }, { enableHighAccuracy: true });
        });

        // --- 2. iPhone IMU Sensor Unlock & Real Packet Stream ---
        document.getElementById('imu-btn').addEventListener('click', async () => {
            logDebug("REQUEST: Requesting iOS DeviceOrientation Permission...");
            if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                try {
                    const response = await DeviceOrientationEvent.requestPermission();
                    if (response === 'granted') {
                        logDebug("SUCCESS: IMU Permission Granted by User.");
                        activateIMUListener();
                    } else {
                        logDebug("WARNING: IMU Permission Denied.");
                        alert('IMU Permission Denied.');
                    }
                } catch (e) {
                    logDebug(`ERROR: IMU Exception -> ${e}`);
                    alert('IMU Error: ' + e);
                }
            } else {
                logDebug("INFO: Standard browser environment, activating IMU directly.");
                activateIMUListener();
            }
        });

        function activateIMUListener() {
            imuActive = true;
            document.getElementById('imu-status').innerText = "STREAMING (60Hz)";
            document.getElementById('imu-status').className = "data-val";
            
            window.addEventListener('deviceorientation', (event) => {
                const alpha = event.alpha ? event.alpha.toFixed(1) : '0.0';
                const beta = event.beta ? event.beta.toFixed(1) : '0.0';
                const gamma = event.gamma ? event.gamma.toFixed(1) : '0.0';
                
                document.getElementById('imu-data').innerText = `${alpha}°, ${beta}°`;
                document.getElementById('imu-data').className = "data-val";

                const timeStampText = new Date().toTimeString().split(' ')[0];
                const tbody = document.getElementById('stream-tbody');
                tbody.innerHTML = `
                    <tr>
                        <td class="status-red">[EUC]</td>
                        <td>PKT_${Math.floor(Math.random()*900+100)}</td>
                        <td class="status-red">DISCONNECTED</td>
                        <td>${timeStampText}</td>
                    </tr>
                    <tr>
                        <td class="data-val">[iPhone]</td>
                        <td>IMU_RAW</td>
                        <td class="data-val">α:${alpha} β:${beta} γ:${gamma}</td>
                        <td>${timeStampText}</td>
                    </tr>
                `;
            }, true);
        }

        // --- 3. Tactical Camera Feed (PIP) ---
        const videoElem = document.getElementById('tactical-video');
        document.getElementById('cam-toggle').addEventListener('click', async () => {
            logDebug("REQUEST: Initializing Tactical Optical Feed (MediaDevices)...");
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
                videoElem.srcObject = stream;
                logDebug("SUCCESS: Optical Feed Stream Active.");
                document.getElementById('cam-overlay-text').innerText = "CAM: ACTIVE";
                document.getElementById('cam-overlay-text').className = "cam-overlay";
            } catch (e) {
                logDebug(`ERROR: Optical Feed Failed -> ${e.message}`);
                document.getElementById('cam-overlay-text').innerText = "CAM: FAULT";
                document.getElementById('cam-overlay-text').className = "cam-overlay status-red";
            }
        });

        // --- 4. Soul Archive Recording (*.krm / karma) ---
        document.getElementById('record-karma-btn').addEventListener('click', () => {
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2,'0')}.${String(now.getMinutes()).padStart(2,'0')}`;
            const bedtime = `${timeStr}-06.00`;
            const karmaName = `Soul_${now.getDate()}-${now.getMonth()+1}-${now.getFullYear()}_${bedtime}.krm`;
            
            karmaArchives.push({ filename: karmaName, timestamp: now.toISOString(), lat, lng });
            logDebug(`ARCHIVE: Saved Soul Snapshot -> ${karmaName}`);
            renderKarmaList();
        });

        function renderKarmaList() {
            const listEl = document.getElementById('karma-list');
            listEl.innerHTML = '';
            karmaArchives.forEach((item) => {
                const div = document.createElement('div');
                div.className = 'karma-item';
                div.innerHTML = `<span>📂 ${item.filename}</span><span>👁️</span>`;
                div.addEventListener('click', () => {
                    logDebug(`INSPECT: Loaded Archive [${item.filename}]`);
                    alert(`Loaded Soul Archive [${item.filename}]\nLat/Lng: ${item.lat.toFixed(4)}, ${item.lng.toFixed(4)}`);
                });
                listEl.appendChild(div);
            });
        }

        // --- 5. WebGL 3D Quantum Voxel Contour Engine ---
        const canvas3D = document.getElementById('webgl-canvas');
        const renderer = new THREE.WebGLRenderer({ canvas: canvas3D, antialias: false, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 50, 70);
        camera.lookAt(0, 0, 0);

        const size = 40;
        const geometry = new THREE.BoxGeometry(0.85, 0.85, 0.85);
        const material = new THREE.MeshBasicMaterial({ color: 0x00ffcc, wireframe: true });
        
        const count = size * size;
        const voxelMesh = new THREE.InstancedMesh(geometry, material, count);
        voxelMesh.frustumCulled = true;

        const dummy = new THREE.Object3D();
        let idx = 0;
        for (let x = 0; x < size; x++) {
            for (let z = 0; z < size; z++) {
                const px = (x - size / 2) * 1.2;
                const pz = (z - size / 2) * 1.2;
                const py = Math.sin(x * 0.15) * Math.cos(z * 0.15) * 5;
                dummy.position.set(px, py, pz);
                dummy.updateMatrix();
                voxelMesh.setMatrixAt(idx++, dummy.matrix);
            }
        }
        scene.add(voxelMesh);

        let lastTime = performance.now();
        let frameCount = 0;
        function animate() {
            requestAnimationFrame(animate);
            const now = performance.now();
            frameCount++;
            if (now - lastTime >= 1000) {
                document.getElementById('fps').innerText = Math.round((frameCount * 1000) / (now - lastTime)) + " FPS";
                frameCount = 0;
                lastTime = now;
            }
            if (active3D) {
                voxelMesh.rotation.y += 0.004;
            }
            renderer.render(scene, camera);
        }
        animate();

        // --- 6. Transition Action ---
        const btn = document.getElementById('transfer-btn');
        const container = document.getElementById('view-container');
        const modeText = document.getElementById('mode-text');

        btn.addEventListener('click', () => {
            active3D = !active3D;
            logDebug(`MODE SWITCH: 3D Quantum Voxel Active = ${active3D}`);
            if (active3D) {
                container.classList.add('active-3d');
            } else {
                container.classList.remove('active-3d');
            }
        });

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
